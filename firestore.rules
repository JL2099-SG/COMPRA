rules_version = '2';
// Reglas de La compra de casa.
// Solo se puede leer o escribir una lista conociendo su código secreto (va en el enlace).
// No se pueden listar las listas existentes ni escribir fuera de "items" y "catalogo".
service cloud.firestore {
  match /databases/{database}/documents {
    function listaValida(lista) {
      return lista.size() >= 20 && lista.size() <= 64;
    }
    function nombreValido() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;
    }

    match /listas/{lista}/items/{id} {
      allow read, delete: if listaValida(lista);
      allow create, update: if listaValida(lista) && nombreValido()
        && request.resource.data.keys().hasOnly(['name', 'aisle', 'done', 'addedBy', 'createdAt'])
        && request.resource.data.aisle is string && request.resource.data.aisle.size() <= 20
        && request.resource.data.done is bool;
    }

    match /listas/{lista}/catalogo/{id} {
      allow read, delete: if listaValida(lista);
      allow create, update: if listaValida(lista) && nombreValido()
        && request.resource.data.keys().hasOnly(['name', 'aisle', 'hidden', 'createdAt']);
    }

    // Clima de casa: el puente del Surface publica el estado y recoge las órdenes de la app.
    // Igual que las listas: solo con el código secreto de casa (va en el enlace).
    match /clima/{casa} {
      allow read: if listaValida(casa);
      allow create, update: if listaValida(casa)
        && request.resource.data.keys().hasOnly(['json', 'updatedAt'])
        && request.resource.data.json is string && request.resource.data.json.size() <= 8000
        && request.resource.data.updatedAt is timestamp;
    }
    match /clima/{casa}/cmds/{id} {
      allow read, delete: if listaValida(casa);
      allow create: if listaValida(casa)
        && request.resource.data.keys().hasOnly(['zone', 'on', 'setpoint', 'mode', 'at'])
        && request.resource.data.zone is int && request.resource.data.zone >= 1 && request.resource.data.zone <= 32
        && (!('on' in request.resource.data) || request.resource.data.on is bool)
        && (!('setpoint' in request.resource.data) || (request.resource.data.setpoint is number
              && request.resource.data.setpoint >= 10 && request.resource.data.setpoint <= 35))
        && (!('mode' in request.resource.data) || (request.resource.data.mode is int
              && request.resource.data.mode >= 1 && request.resource.data.mode <= 8));
    }
  }
}
